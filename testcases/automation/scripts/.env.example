# WeMine Automation Test Environment Configuration
# Copy this file to .env and fill in the values

# Application URLs
BASE_URL=https://wemine-office.example.com
API_URL=https://api.wemine.example.com

# Test User Credentials
TEST_USERNAME=testuser@company.com
TEST_PASSWORD=your-secure-password

# Optional: CI/CD specific
CI=false
HEADLESS=true

# Optional: Test Data
TEST_TENANT_ID=test-tenant-123
TEST_LOCATION_ID=loc-001
